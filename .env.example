PORT=3000
ADMIN_PASSWORD=change-moi

# Optionnel : chemin local du dossier synchronise par le client de bureau
# "Doctolib Documents". Si defini, chaque bilan est aussi depose la, en plus
# d'etre telechargeable depuis l'espace cabinet.
# Exemple Windows : C:\Users\Maissa\Documents\Doctolib
DOCTOLIB_SYNC_DIR=
